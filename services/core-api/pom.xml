<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
	xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
	<modelVersion>4.0.0</modelVersion>
	<parent>
		<groupId>org.springframework.boot</groupId>
		<artifactId>spring-boot-starter-parent</artifactId>
		<version>4.1.0</version>
		<relativePath/> <!-- lookup parent from repository -->
	</parent>
	<groupId>io.authweave</groupId>
	<artifactId>core-api</artifactId>
	<version>0.0.1-SNAPSHOT</version>
	<name>core-api</name>
	<description>Deterministic decision core for AuthWeave</description>
	<url/>
	<licenses>
		<license/>
	</licenses>
	<developers>
		<developer/>
	</developers>
	<scm>
		<connection/>
		<developerConnection/>
		<tag/>
		<url/>
	</scm>
	<properties>
		<java.version>21</java.version>
		<authweave.postgres.port>5432</authweave.postgres.port>
		<authweave.postgres.database>authweave</authweave.postgres.database>
		<authweave.codegen.url>jdbc:postgresql://localhost:${authweave.postgres.port}/${authweave.postgres.database}</authweave.codegen.url>
		<authweave.codegen.user>authweave_admin</authweave.codegen.user>
	</properties>
	<dependencies>
		<dependency>
			<groupId>org.springframework.boot</groupId>
			<artifactId>spring-boot-starter-flyway</artifactId>
		</dependency>
		<dependency>
			<groupId>org.springframework.boot</groupId>
			<artifactId>spring-boot-starter-jdbc</artifactId>
		</dependency>
		<dependency>
			<groupId>org.springframework.boot</groupId>
			<artifactId>spring-boot-starter-jooq</artifactId>
		</dependency>
		<dependency>
			<groupId>org.springframework.boot</groupId>
			<artifactId>spring-boot-starter-actuator</artifactId>
		</dependency>
		<dependency>
			<groupId>org.springframework.boot</groupId>
			<artifactId>spring-boot-starter-validation</artifactId>
		</dependency>
		<dependency>
			<groupId>org.springframework.boot</groupId>
			<artifactId>spring-boot-starter-webmvc</artifactId>
		</dependency>
		<dependency>
			<groupId>org.flywaydb</groupId>
			<artifactId>flyway-database-postgresql</artifactId>
		</dependency>
		<dependency>
			<groupId>org.postgresql</groupId>
			<artifactId>postgresql</artifactId>
			<scope>runtime</scope>
		</dependency>

		<dependency>
			<groupId>org.springframework.boot</groupId>
			<artifactId>spring-boot-starter-actuator-test</artifactId>
			<scope>test</scope>
		</dependency>
		<dependency>
			<groupId>org.springframework.boot</groupId>
			<artifactId>spring-boot-starter-validation-test</artifactId>
			<scope>test</scope>
		</dependency>
		<dependency>
			<groupId>org.springframework.boot</groupId>
			<artifactId>spring-boot-starter-webmvc-test</artifactId>
			<scope>test</scope>
		</dependency>
		<dependency>
			<groupId>org.testcontainers</groupId>
			<artifactId>testcontainers-postgresql</artifactId>
			<scope>test</scope>
		</dependency>
	</dependencies>

	<build>
		<plugins>
			<plugin>
				<groupId>org.codehaus.mojo</groupId>
				<artifactId>build-helper-maven-plugin</artifactId>
				<executions>
					<execution>
						<id>add-jooq-generated-sources</id>
						<phase>generate-sources</phase>
						<goals>
							<goal>add-source</goal>
						</goals>
						<configuration>
							<sources>
								<source>${project.basedir}/src/generated/java</source>
							</sources>
						</configuration>
					</execution>
				</executions>
			</plugin>
			<plugin>
				<groupId>org.springframework.boot</groupId>
				<artifactId>spring-boot-maven-plugin</artifactId>
			</plugin>
		</plugins>
	</build>

	<profiles>
		<profile>
			<id>jooq-codegen</id>
			<build>
				<plugins>
					<plugin>
						<groupId>org.flywaydb</groupId>
						<artifactId>flyway-maven-plugin</artifactId>
						<dependencies>
							<dependency>
								<groupId>org.flywaydb</groupId>
								<artifactId>flyway-database-postgresql</artifactId>
								<version>${flyway.version}</version>
							</dependency>
							<dependency>
								<groupId>org.postgresql</groupId>
								<artifactId>postgresql</artifactId>
								<version>${postgresql.version}</version>
							</dependency>
						</dependencies>
						<executions>
							<execution>
								<id>migrate-codegen-database</id>
								<phase>initialize</phase>
								<goals>
									<goal>migrate</goal>
								</goals>
							</execution>
						</executions>
						<configuration>
							<url>${authweave.codegen.url}</url>
							<user>${authweave.codegen.user}</user>
							<password>${env.AUTHWEAVE_POSTGRES_ADMIN_PASSWORD}</password>
							<locations>
								<location>filesystem:${project.basedir}/src/main/resources/db/migration</location>
							</locations>
							<defaultSchema>authweave_migrations</defaultSchema>
							<createSchemas>true</createSchemas>
						</configuration>
					</plugin>
					<plugin>
						<groupId>org.jooq</groupId>
						<artifactId>jooq-codegen-maven</artifactId>
						<dependencies>
							<dependency>
								<groupId>org.postgresql</groupId>
								<artifactId>postgresql</artifactId>
								<version>${postgresql.version}</version>
							</dependency>
						</dependencies>
						<executions>
							<execution>
								<id>generate-jooq-sources</id>
								<phase>generate-sources</phase>
								<goals>
									<goal>generate</goal>
								</goals>
							</execution>
							<execution>
								<id>generate-audit-jooq-sources</id>
								<phase>generate-sources</phase>
								<goals><goal>generate</goal></goals>
								<configuration>
									<generator>
										<database>
											<inputSchema>audit</inputSchema>
											<includes>assessment_events</includes>
										</database>
										<target>
											<packageName>io.authweave.core.generated.audit</packageName>
										</target>
									</generator>
								</configuration>
							</execution>
						</executions>
						<configuration>
							<jdbc>
								<driver>org.postgresql.Driver</driver>
								<url>${authweave.codegen.url}</url>
								<user>${authweave.codegen.user}</user>
								<password>${env.AUTHWEAVE_POSTGRES_ADMIN_PASSWORD}</password>
							</jdbc>
							<generator>
								<database>
									<name>org.jooq.meta.postgres.PostgresDatabase</name>
									<inputSchema>core</inputSchema>
									<includes>workspaces|assessments|assessment_revisions</includes>
								</database>
								<generate>
									<deprecated>false</deprecated>
									<records>true</records>
									<generatedAnnotation>true</generatedAnnotation>
									<generatedAnnotationDate>false</generatedAnnotationDate>
								</generate>
								<target>
									<packageName>io.authweave.core.generated.jooq</packageName>
									<directory>${project.basedir}/src/generated/java</directory>
									<clean>true</clean>
								</target>
							</generator>
						</configuration>
					</plugin>
				</plugins>
			</build>
		</profile>
		<profile>
			<id>postgres-port-from-environment</id>
			<activation><property><name>env.AUTHWEAVE_POSTGRES_PORT</name></property></activation>
			<properties><authweave.postgres.port>${env.AUTHWEAVE_POSTGRES_PORT}</authweave.postgres.port></properties>
		</profile>
		<profile>
			<id>postgres-database-from-environment</id>
			<activation><property><name>env.AUTHWEAVE_POSTGRES_DB</name></property></activation>
			<properties><authweave.postgres.database>${env.AUTHWEAVE_POSTGRES_DB}</authweave.postgres.database></properties>
		</profile>
		<profile>
			<id>postgres-admin-from-environment</id>
			<activation><property><name>env.AUTHWEAVE_POSTGRES_ADMIN_USER</name></property></activation>
			<properties><authweave.codegen.user>${env.AUTHWEAVE_POSTGRES_ADMIN_USER}</authweave.codegen.user></properties>
		</profile>
		<profile>
			<id>core-url-from-environment</id>
			<activation><property><name>env.AUTHWEAVE_CORE_DB_URL</name></property></activation>
			<properties><authweave.codegen.url>${env.AUTHWEAVE_CORE_DB_URL}</authweave.codegen.url></properties>
		</profile>
		<!-- Declared last so the migration connection wins over the runtime connection. -->
		<profile>
			<id>migration-url-from-environment</id>
			<activation><property><name>env.AUTHWEAVE_MIGRATION_DB_URL</name></property></activation>
			<properties><authweave.codegen.url>${env.AUTHWEAVE_MIGRATION_DB_URL}</authweave.codegen.url></properties>
		</profile>
	</profiles>

</project>
