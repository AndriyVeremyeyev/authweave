# Local development only. Keep placeholders here and store real values in .env.
AUTHWEAVE_POSTGRES_DB=authweave
AUTHWEAVE_POSTGRES_ADMIN_USER=authweave_admin
AUTHWEAVE_POSTGRES_ADMIN_PASSWORD=choose-a-local-only-password
AUTHWEAVE_POSTGRES_PORT=5432
AUTHWEAVE_CORE_DB_PASSWORD=choose-a-different-local-only-password
AUTHWEAVE_WEB_DB_PASSWORD=choose-another-local-only-password

# Optional JDBC overrides. Migrations and jOOQ use the migration URL, then the core URL,
# then the local port/database above. Keep credentials in the password variables.
# AUTHWEAVE_CORE_DB_URL=jdbc:postgresql://localhost:5432/authweave
# AUTHWEAVE_MIGRATION_DB_URL=jdbc:postgresql://localhost:5432/authweave
