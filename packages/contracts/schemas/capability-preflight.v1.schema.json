{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://authweave.dev/contracts/capability-preflight.v1.schema.json",
  "title": "Synthetic capability preflight v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "workspaceId",
    "assessmentId",
    "assessmentVersion",
    "catalogVersion",
    "catalogKind",
    "policyVersion",
    "evaluatedAt",
    "scope",
    "recommendationReady",
    "deferredPaths",
    "candidates"
  ],
  "properties": {
    "workspaceId": {
      "type": "string",
      "format": "uuid"
    },
    "assessmentId": {
      "type": "string",
      "format": "uuid"
    },
    "assessmentVersion": {
      "type": "integer",
      "minimum": 0
    },
    "catalogVersion": {
      "$ref": "./synthetic-provider-catalog.v1.schema.json#/$defs/identifier"
    },
    "catalogKind": {
      "const": "SYNTHETIC"
    },
    "policyVersion": {
      "const": "capability-preflight-1"
    },
    "evaluatedAt": {
      "type": "string",
      "format": "date-time"
    },
    "scope": {
      "const": "CAPABILITY_PREFLIGHT"
    },
    "recommendationReady": {
      "const": false
    },
    "deferredPaths": {
      "type": "array",
      "minItems": 8,
      "maxItems": 8,
      "uniqueItems": true,
      "items": {
        "enum": [
          "application",
          "audience",
          "security.browserTokenExposureMinimization",
          "security.auditability",
          "security.dataResidency",
          "security.assurance",
          "security.complianceTargets",
          "operations"
        ]
      }
    },
    "candidates": {
      "type": "array",
      "minItems": 1,
      "maxItems": 100,
      "items": {
        "$ref": "#/$defs/candidate"
      }
    }
  },
  "$defs": {
    "candidate": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "optionId",
        "displayName",
        "plan",
        "region",
        "status",
        "checks"
      ],
      "properties": {
        "optionId": {
          "$ref": "./synthetic-provider-catalog.v1.schema.json#/$defs/identifier"
        },
        "displayName": {
          "$ref": "./synthetic-provider-catalog.v1.schema.json#/$defs/label"
        },
        "plan": {
          "$ref": "./synthetic-provider-catalog.v1.schema.json#/$defs/label"
        },
        "region": {
          "$ref": "./synthetic-provider-catalog.v1.schema.json#/$defs/label"
        },
        "status": {
          "enum": [
            "MATCHES_CHECKED_REQUIREMENTS",
            "DOES_NOT_MATCH",
            "NEEDS_INFORMATION"
          ]
        },
        "checks": {
          "type": "array",
          "minItems": 9,
          "maxItems": 9,
          "items": {
            "$ref": "#/$defs/check"
          }
        }
      }
    },
    "check": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "capability",
        "profilePath",
        "criticality",
        "outcome",
        "reasonCode",
        "explanation",
        "evidence"
      ],
      "properties": {
        "capability": {
          "$ref": "./synthetic-provider-catalog.v1.schema.json#/$defs/capability"
        },
        "profilePath": {
          "enum": [
            "protocols.federation.OIDC",
            "protocols.federation.SAML",
            "protocols.oauth2ProtectedApis",
            "protocols.socialLogin",
            "protocols.enterpriseSingleSignOn",
            "provisioning.scim",
            "provisioning.justInTimeProvisioning",
            "provisioning.groupSynchronization",
            "security.multiFactorAuthentication"
          ]
        },
        "criticality": {
          "$ref": "./application-identity-profile.v1.schema.json#/$defs/criticality"
        },
        "outcome": {
          "enum": [
            "PASS",
            "FAIL",
            "UNKNOWN",
            "NOT_APPLIED"
          ]
        },
        "reasonCode": {
          "enum": [
            "REQUIRED_CAPABILITY_AVAILABLE",
            "REQUIRED_CAPABILITY_UNAVAILABLE",
            "FORBIDDEN_CAPABILITY_UNAVOIDABLE",
            "FORBIDDEN_CAPABILITY_AVOIDABLE",
            "REQUIREMENT_UNKNOWN",
            "CAPABILITY_UNKNOWN",
            "EVIDENCE_MISSING",
            "EVIDENCE_UNREVIEWED",
            "EVIDENCE_STALE",
            "EVIDENCE_FROM_FUTURE",
            "PREFERENCE_NOT_SCORED",
            "NO_REQUIREMENT"
          ]
        },
        "explanation": {
          "type": "string",
          "minLength": 1,
          "maxLength": 300
        },
        "evidence": {
          "oneOf": [
            {
              "type": "null"
            },
            {
              "$ref": "./synthetic-provider-catalog.v1.schema.json#/$defs/fact"
            }
          ]
        }
      }
    }
  }
}
