{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://authweave.dev/contracts/catalog-fact-review.v1.schema.json",
  "title": "Recorded manual source-review observation v1",
  "type": "object",
  "additionalProperties": false,
  "required": ["reviewId", "proposalId", "proposalVersion", "proposalSha256", "reviewNumber", "optionId", "factPath", "verdict", "recordedAt", "kind", "sourceVerificationPerformed", "approvalGranted", "catalogWritesPerformed", "factTrustChanged"],
  "properties": {
    "reviewId": { "type": "string", "format": "uuid" },
    "proposalId": { "type": "string", "format": "uuid" },
    "proposalVersion": { "type": "integer", "minimum": 0, "maximum": 9007199254740991 },
    "proposalSha256": { "type": "string", "pattern": "^[0-9a-f]{64}$" },
    "reviewNumber": { "type": "integer", "minimum": 1, "maximum": 9007199254740991 },
    "optionId": { "$ref": "catalog-fact-review-request.v1.schema.json#/properties/optionId" },
    "factPath": { "$ref": "catalog-fact-review-request.v1.schema.json#/properties/factPath" },
    "verdict": { "$ref": "catalog-fact-review-request.v1.schema.json#/properties/verdict" },
    "recordedAt": { "type": "string", "format": "date-time" },
    "kind": { "const": "HUMAN_SOURCE_REVIEW_OBSERVATION" },
    "sourceVerificationPerformed": { "const": false },
    "approvalGranted": { "const": false },
    "catalogWritesPerformed": { "const": false },
    "factTrustChanged": { "const": false }
  }
}
