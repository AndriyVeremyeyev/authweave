{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://authweave.dev/contracts/catalog-fact-review-summary-page.v1.schema.json",
  "title": "Exact-revision latest human observation summary page v1",
  "description": "Counts for all recorded candidate facts, classified by their newest committed per-fact review number, with at most 20 fact targets per page. reviewThroughNumber identifies the latest observation included by the single ledger read. Later reads may see new observations. These are human reports, not verified fact statuses, freshness, eligibility or approval. No audit actor disclosure.",
  "type": "object",
  "additionalProperties": false,
  "required": ["proposalId", "proposalVersion", "proposalSha256", "policyVersion", "reviewThroughNumber", "factCount", "counts", "offset", "items", "nextOffset", "sourceVerificationPerformed", "approvalGranted", "catalogWritesPerformed", "factTrustChanged"],
  "properties": {
    "proposalId": { "type": "string", "format": "uuid" },
    "proposalVersion": { "type": "integer", "minimum": 0, "maximum": 9007199254740991 },
    "proposalSha256": { "type": "string", "pattern": "^[0-9a-f]{64}$" },
    "policyVersion": { "const": "catalog-fact-review-summary-1" },
    "reviewThroughNumber": { "type": "integer", "minimum": 0, "maximum": 9007199254740991 },
    "factCount": { "$ref": "#/$defs/count" },
    "counts": {
      "type": "object", "additionalProperties": false,
      "required": ["noObservation", "sourceSupportsClaim", "sourceDoesNotSupportClaim", "insufficientEvidence"],
      "properties": {
        "noObservation": { "$ref": "#/$defs/count" },
        "sourceSupportsClaim": { "$ref": "#/$defs/count" },
        "sourceDoesNotSupportClaim": { "$ref": "#/$defs/count" },
        "insufficientEvidence": { "$ref": "#/$defs/count" }
      }
    },
    "offset": { "$ref": "#/$defs/count" },
    "items": {
      "type": "array", "maxItems": 20,
      "items": {
        "type": "object", "additionalProperties": false, "required": ["optionId", "factPath", "latestObservation"],
        "properties": {
          "optionId": { "$ref": "catalog-fact-review-request.v1.schema.json#/properties/optionId" },
          "factPath": { "$ref": "catalog-fact-review-request.v1.schema.json#/properties/factPath" },
          "latestObservation": { "anyOf": [{ "type": "null" }, { "$ref": "catalog-fact-review.v1.schema.json" }] }
        }
      }
    },
    "nextOffset": { "type": ["integer", "null"], "minimum": 1, "maximum": 6800 },
    "sourceVerificationPerformed": { "const": false },
    "approvalGranted": { "const": false },
    "catalogWritesPerformed": { "const": false },
    "factTrustChanged": { "const": false }
  },
  "$defs": { "count": { "type": "integer", "minimum": 0, "maximum": 6800 } }
}
