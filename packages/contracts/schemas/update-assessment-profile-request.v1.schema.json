{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://authweave.dev/contracts/update-assessment-profile-request.v1.schema.json",
  "title": "Update assessment profile request v1",
  "type": "object",
  "additionalProperties": false,
  "required": ["expectedVersion", "profile"],
  "properties": {
    "expectedVersion": {
      "type": "integer",
      "minimum": 0,
      "maximum": 9007199254740991,
      "description": "A non-negative integer representable exactly by JavaScript clients."
    },
    "profile": {
      "$ref": "./application-identity-profile.v1.schema.json"
    }
  }
}
