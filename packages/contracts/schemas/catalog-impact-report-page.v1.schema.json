{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://authweave.dev/contracts/catalog-impact-report-page.v1.schema.json",
  "title": "Stored impact report page v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "items",
    "nextAfterReportNumber"
  ],
  "properties": {
    "items": {
      "type": "array",
      "maxItems": 100,
      "items": {
        "$ref": "./catalog-impact-report.v1.schema.json"
      }
    },
    "nextAfterReportNumber": {
      "oneOf": [
        {
          "type": "null"
        },
        {
          "type": "integer",
          "minimum": 1,
          "maximum": 9007199254740991
        }
      ]
    }
  }
}
