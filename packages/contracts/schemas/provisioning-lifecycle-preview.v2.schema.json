          "additionalProperties": false,
          "required": ["conditionId","description"],
          "properties": {"conditionId":{"const":"SCIM_USER_OPERATIONS"},"description":{"type":"string","minLength":1,"maxLength":512}}
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["conditionId","description"],
          "properties": {"conditionId":{"const":"JIT_TRUSTED_LOGIN_AND_LINKING"},"description":{"type":"string","minLength":1,"maxLength":512}}
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["conditionId","description"],
          "properties": {"conditionId":{"const":"SCIM_JIT_COLLISION_POLICY"},"description":{"type":"string","minLength":1,"maxLength":512}}
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["conditionId","description"],
          "properties": {"conditionId":{"const":"GROUP_SOURCE_AND_MEMBERSHIP_MAPPING"},"description":{"type":"string","minLength":1,"maxLength":512}}
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["conditionId","description"],
          "properties": {"conditionId":{"const":"GROUP_CHANGE_DELIVERY_AND_RECONCILIATION"},"description":{"type":"string","minLength":1,"maxLength":512}}
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["conditionId","description"],
          "properties": {"conditionId":{"const":"GROUP_TO_ROLE_MAPPING_AND_ENFORCEMENT"},"description":{"type":"string","minLength":1,"maxLength":512}}
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["conditionId","description"],
          "properties": {"conditionId":{"const":"GROUP_REMOVAL_AND_ACCESS_RECHECK"},"description":{"type":"string","minLength":1,"maxLength":512}}
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["conditionId","description"],
          "properties": {"conditionId":{"const":"SCIM_GROUP_OPERATIONS"},"description":{"type":"string","minLength":1,"maxLength":512}}
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["conditionId","description"],
          "properties": {
            "conditionId": {"const":"APPLICATION_BRIDGE_AUTHORIZATION_AND_IDEMPOTENCY"},
            "description": {"type":"string","minLength":1,"maxLength":512}
          }
        }
      ],
      "items": false
    },
    "offboardingReferences": {"const":["https://www.rfc-editor.org/rfc/rfc7643.html#section-4.1.1","https://www.rfc-editor.org/rfc/rfc7009.html#section-3"]},
    "checkedProfilePaths": {"const":["provisioning.scim","provisioning.justInTimeProvisioning","provisioning.groupSynchronization"]},
    "deferredBoundaries": {
      "const": [
        "providerOperationsAndEntitlements",
        "observedProvisioningDelivery",
        "groupMembershipAndAuthorization",
        "sessionAndTokenRevocation",
        "reconciliationAndFailureRecovery"
      ]
    },
    "configurationVerified": {"const":false},
    "providerCompatibilityVerified": {"const":false},
    "lifecycleVerified": {"const":false},
    "groupSynchronizationVerified": {"const":false},
    "accessRevocationVerified": {"const":false},
    "writesPerformed": {"const":false},
    "publicationReady": {"const":false},
    "recommendationReady": {"const":false}
  },
  "$defs": {
    "requirementCheck": {
      "type": "object",
      "additionalProperties": false,
      "required": ["profilePath","outcome","reasonCode","criticality"],
      "properties": {
        "profilePath": {"enum":["provisioning.scim","provisioning.justInTimeProvisioning","provisioning.groupSynchronization"]},
        "outcome": {"enum":["CONDITIONALLY_SATISFIED","CONDITIONALLY_NOT_SATISFIED","UNKNOWN","NOT_APPLIED"]},
        "reasonCode": {
          "enum": [
            "REQUIRED_MECHANISM_PLANNED",
            "REQUIRED_MECHANISM_ABSENT",
            "FORBIDDEN_MECHANISM_PLANNED",
            "FORBIDDEN_MECHANISM_ABSENT",
            "REQUIREMENT_UNKNOWN",
            "PREFERENCE_NOT_SCORED",
            "NO_REQUIREMENT",
            "GROUP_STRATEGY_UNKNOWN"
          ]
        },
        "criticality": {"enum":["UNKNOWN","REQUIRED","PREFERRED","NOT_REQUIRED","FORBIDDEN"]}
      },
      "allOf": [
        {
          "if": {"properties":{"reasonCode":{"const":"REQUIRED_MECHANISM_PLANNED"}}},
          "then": {"properties":{"outcome":{"const":"CONDITIONALLY_SATISFIED"}}}
        },
        {
          "if": {"properties":{"reasonCode":{"const":"REQUIRED_MECHANISM_ABSENT"}}},
          "then": {"properties":{"outcome":{"const":"CONDITIONALLY_NOT_SATISFIED"}}}
        },
        {
          "if": {"properties":{"reasonCode":{"const":"FORBIDDEN_MECHANISM_PLANNED"}}},
          "then": {"properties":{"outcome":{"const":"CONDITIONALLY_NOT_SATISFIED"}}}
        },
        {
          "if": {"properties":{"reasonCode":{"const":"FORBIDDEN_MECHANISM_ABSENT"}}},
          "then": {"properties":{"outcome":{"const":"CONDITIONALLY_SATISFIED"}}}
        },
        {"if":{"properties":{"reasonCode":{"const":"REQUIREMENT_UNKNOWN"}}},"then":{"properties":{"outcome":{"const":"UNKNOWN"}}}},
        {"if":{"properties":{"reasonCode":{"const":"PREFERENCE_NOT_SCORED"}}},"then":{"properties":{"outcome":{"const":"NOT_APPLIED"}}}},
        {"if":{"properties":{"reasonCode":{"const":"NO_REQUIREMENT"}}},"then":{"properties":{"outcome":{"const":"NOT_APPLIED"}}}},
        {"if":{"properties":{"reasonCode":{"const":"GROUP_STRATEGY_UNKNOWN"}}},"then":{"properties":{"outcome":{"const":"UNKNOWN"}}}}
      ]
    },
    "designCheck": {
      "type": "object",
      "additionalProperties": false,
      "required": ["boundary","outcome","reasonCode"],
      "properties": {
        "boundary": {"enum":["groupTransport"]},
        "outcome": {"enum":["CONDITIONALLY_SATISFIED","CONDITIONALLY_NOT_SATISFIED","UNKNOWN","NOT_APPLIED"]},
        "reasonCode": {"enum":["GROUP_STRATEGY_UNKNOWN","GROUP_TRANSPORT_PLANNED","NO_GROUP_TRANSPORT_PLANNED","SCIM_GROUPS_REQUIRE_SCIM_PATTERN"]}
      },
      "allOf": [
        {"if":{"properties":{"reasonCode":{"const":"GROUP_STRATEGY_UNKNOWN"}}},"then":{"properties":{"outcome":{"const":"UNKNOWN"}}}},
        {
          "if": {"properties":{"reasonCode":{"const":"GROUP_TRANSPORT_PLANNED"}}},
          "then": {"properties":{"outcome":{"const":"CONDITIONALLY_SATISFIED"}}}
        },
        {
          "if": {"properties":{"reasonCode":{"const":"NO_GROUP_TRANSPORT_PLANNED"}}},
          "then": {"properties":{"outcome":{"const":"NOT_APPLIED"}}}
        },
        {
          "if": {"properties":{"reasonCode":{"const":"SCIM_GROUPS_REQUIRE_SCIM_PATTERN"}}},
          "then": {"properties":{"outcome":{"const":"CONDITIONALLY_NOT_SATISFIED"}}}
        }
      ]
    },
    "conditionCheck": {
      "type": "object",
      "additionalProperties": false,
      "required": ["conditionId","outcome","reasonCode"],
      "properties": {
        "conditionId": {
          "enum": [
            "TENANT_AND_SUBJECT_CORRELATION",
            "ATTRIBUTE_OWNERSHIP_AND_MAPPING",
            "ACCOUNT_DISABLE_AND_LOGIN_BLOCK",
            "APPLICATION_SESSION_INVALIDATION",
            "TOKEN_REVOCATION_OR_BOUNDED_EXPIRY",
            "FAILURE_RECOVERY_AND_RECONCILIATION",
            "SCIM_CLIENT_SERVER_DIRECTION",
            "SCIM_USER_OPERATIONS",
            "JIT_TRUSTED_LOGIN_AND_LINKING",
            "SCIM_JIT_COLLISION_POLICY",
            "GROUP_SOURCE_AND_MEMBERSHIP_MAPPING",
            "GROUP_CHANGE_DELIVERY_AND_RECONCILIATION",
            "GROUP_TO_ROLE_MAPPING_AND_ENFORCEMENT",
            "GROUP_REMOVAL_AND_ACCESS_RECHECK",
            "SCIM_GROUP_OPERATIONS",
            "APPLICATION_BRIDGE_AUTHORIZATION_AND_IDEMPOTENCY"
          ]
        },
        "outcome": {"enum":["CONDITIONALLY_SATISFIED","CONDITIONALLY_NOT_SATISFIED","UNKNOWN","NOT_APPLIED"]},
        "reasonCode": {"enum":["DECLARED_CONDITION_SATISFIED","DECLARED_CONDITION_NOT_SATISFIED","CONDITION_UNKNOWN"]}
      },
      "allOf": [
        {
          "if": {"properties":{"reasonCode":{"const":"DECLARED_CONDITION_SATISFIED"}}},
          "then": {"properties":{"outcome":{"const":"CONDITIONALLY_SATISFIED"}}}
        },
        {
          "if": {"properties":{"reasonCode":{"const":"DECLARED_CONDITION_NOT_SATISFIED"}}},
          "then": {"properties":{"outcome":{"const":"CONDITIONALLY_NOT_SATISFIED"}}}
        },
        {"if":{"properties":{"reasonCode":{"const":"CONDITION_UNKNOWN"}}},"then":{"properties":{"outcome":{"const":"UNKNOWN"}}}}
      ]
    },
    "groupDefinition": {
      "type": "object",
      "additionalProperties": false,
      "required": ["groupStrategy","displayName","advantages","tradeoffs","conditions","references"],
      "properties": {
        "groupStrategy": {"enum":["UNKNOWN","NONE","SCIM_GROUPS","APPLICATION_BRIDGE"]},
        "displayName": {"type":"string","minLength":1,"maxLength":160},
        "advantages": {"type":"array","maxItems":4,"items":{"type":"string","minLength":1,"maxLength":512}},
        "tradeoffs": {"type":"array","minItems":1,"maxItems":4,"items":{"type":"string","minLength":1,"maxLength":512}},
        "conditions": {
          "type": "array",
          "maxItems": 5,
          "items": {
            "enum": [
              "GROUP_SOURCE_AND_MEMBERSHIP_MAPPING",
              "GROUP_CHANGE_DELIVERY_AND_RECONCILIATION",
              "GROUP_TO_ROLE_MAPPING_AND_ENFORCEMENT",
              "GROUP_REMOVAL_AND_ACCESS_RECHECK",
              "SCIM_GROUP_OPERATIONS",
              "APPLICATION_BRIDGE_AUTHORIZATION_AND_IDEMPOTENCY"
            ]
          }
        },
        "references": {"type":"array","maxItems":2,"items":{"type":"string","format":"uri","pattern":"^https://"}}
      },
      "allOf": [
        {
          "if": {"properties":{"groupStrategy":{"const":"UNKNOWN"}}},
          "then": {"properties":{"conditions":{"const":[]},"references":{"const":[]}}}
        },
        {"if":{"properties":{"groupStrategy":{"const":"NONE"}}},"then":{"properties":{"conditions":{"const":[]},"references":{"const":[]}}}},
        {
          "if": {"properties":{"groupStrategy":{"const":"SCIM_GROUPS"}}},
          "then": {
            "properties": {
              "conditions": {
                "const": [
                  "GROUP_SOURCE_AND_MEMBERSHIP_MAPPING",
                  "GROUP_CHANGE_DELIVERY_AND_RECONCILIATION",
                  "GROUP_TO_ROLE_MAPPING_AND_ENFORCEMENT",
                  "GROUP_REMOVAL_AND_ACCESS_RECHECK",
                  "SCIM_GROUP_OPERATIONS"
                ]
              },
              "references": {"const":["https://www.rfc-editor.org/rfc/rfc7643.html#section-4.2","https://www.rfc-editor.org/rfc/rfc7644.html"]}
            }
          }
        },
        {
          "if": {"properties":{"groupStrategy":{"const":"APPLICATION_BRIDGE"}}},
          "then": {
            "properties": {
              "conditions": {
                "const": [
                  "GROUP_SOURCE_AND_MEMBERSHIP_MAPPING",
                  "GROUP_CHANGE_DELIVERY_AND_RECONCILIATION",
                  "GROUP_TO_ROLE_MAPPING_AND_ENFORCEMENT",
                  "GROUP_REMOVAL_AND_ACCESS_RECHECK",
                  "APPLICATION_BRIDGE_AUTHORIZATION_AND_IDEMPOTENCY"
                ]
              },
              "references": {"const":[]}
            }
          }
        }
      ]
    }
  }
}
