{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://authweave.dev/contracts/hard-constraint-preflight.v1.schema.json",
  "title": "Synthetic hard-constraint summary preflight v1",
  "type": "object",
  "additionalProperties": false,
  "required": ["workspaceId", "assessmentId", "assessmentVersion", "catalogVersion", "catalogKind", "policyVersion", "evaluatedAt", "scope", "recommendationReady", "deferredPaths", "candidates"],
  "properties": {
    "workspaceId": { "type": "string", "format": "uuid" },
    "assessmentId": { "type": "string", "format": "uuid" },
    "assessmentVersion": { "type": "integer", "minimum": 0 },
    "catalogVersion": { "$ref": "./synthetic-provider-catalog.v1.schema.json#/$defs/identifier" },
    "catalogKind": { "const": "SYNTHETIC" },
    "policyVersion": { "const": "hard-constraint-preflight-1" },
    "evaluatedAt": { "type": "string", "format": "date-time" },
    "scope": { "const": "SYNTHETIC_HARD_CONSTRAINT_PREFLIGHT" },
    "recommendationReady": { "const": false },
    "deferredPaths": { "$ref": "./eligibility-preflight.v4.schema.json#/properties/deferredPaths" },
    "candidates": { "type": "array", "minItems": 1, "maxItems": 100, "items": { "$ref": "#/$defs/candidate" } }
  },
  "$defs": {
    "candidate": {
      "type": "object",
      "additionalProperties": false,
      "required": ["optionId", "displayName", "plan", "region", "verdict", "exclusionReasons", "informationGaps"],
      "properties": {
        "optionId": { "$ref": "./synthetic-provider-catalog.v1.schema.json#/$defs/identifier" },
        "displayName": { "type": "string", "minLength": 1, "maxLength": 120 },
        "plan": { "type": "string", "minLength": 1, "maxLength": 120 },
        "region": { "type": "string", "minLength": 1, "maxLength": 120 },
        "verdict": { "enum": ["EXCLUDED", "UNRESOLVED", "PASSES_CHECKED_REQUIREMENTS"] },
        "exclusionReasons": { "type": "array", "maxItems": 500, "items": { "$ref": "#/$defs/finding" } },
        "informationGaps": { "type": "array", "maxItems": 500, "items": { "$ref": "#/$defs/finding" } }
      }
    },
    "finding": {
      "type": "object",
      "additionalProperties": false,
      "required": ["dimension", "profilePath", "reasonCode", "explanation"],
      "properties": {
        "dimension": { "enum": ["CAPABILITY", "CONTEXT", "RESIDENCY", "AUTHENTICATION_CONTROL", "COMPLIANCE_SCOPE", "COVERAGE"] },
        "profilePath": { "type": "string", "minLength": 1, "maxLength": 200 },
        "reasonCode": { "type": "string", "pattern": "^[A-Z][A-Z0-9_]*$", "maxLength": 100 },
        "explanation": { "type": "string", "minLength": 1, "maxLength": 1000 }
      }
    }
  },
  "description": "Read-only reason-coded summary of existing synthetic checks. Passing means only that checked constraints pass; deferred paths, unknown facts and lack of real provider evidence prevent a final recommendation."
}
