      "const": "auditability-capability-preflight-1"
    },
    "scope": {
      "const": "SYNTHETIC_AUDITABILITY_CAPABILITY_PREFLIGHT"
    },
    "checkedPaths": {
      "const": [
        "security.auditability",
        "security.auditabilityRequirements"
      ]
    },
    "sourceVerificationPerformed": {
      "const": false
    },
    "recommendationReady": {
