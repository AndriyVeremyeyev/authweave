{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://authweave.dev/contracts/auditability-capability-preflight.v1.schema.json",
  "title": "Read-only scoped auditability capability preflight",
  "description": "Private partial synthetic preview of saved requirements and dated option-bound facts. Core binds/recomputes each analysis from returned evidence. No ranking, source fetch, observed logging, compliance or publication authority.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "workspaceId",
    "assessmentId",
    "assessmentVersion",
    "baseCatalogVersion",
    "evidenceVersion",
    "catalogKind",
    "evaluatedAt",
    "criticality",
    "requirements",
    "candidates",
    "policyVersion",
    "scope",
    "checkedPaths",
    "sourceVerificationPerformed",
    "recommendationReady"
  ],
  "properties": {
    "workspaceId": {
      "type": "string",
      "format": "uuid"
    },
    "assessmentId": {
      "type": "string",
      "format": "uuid"
    },
    "assessmentVersion": {
      "type": "integer",
      "minimum": 0,
      "maximum": 9007199254740991
    },
    "baseCatalogVersion": {
      "type": "string",
      "pattern": "^[a-z0-9][a-z0-9.-]{0,99}$"
    },
    "evidenceVersion": {
      "type": "string",
      "pattern": "^[a-z0-9][a-z0-9.-]{0,99}$"
    },
    "catalogKind": {
      "const": "SYNTHETIC"
    },
    "evaluatedAt": {
      "type": "string",
      "format": "date-time"
    },
    "criticality": {
      "enum": [
        "UNKNOWN",
        "REQUIRED",
        "PREFERRED",
        "NOT_REQUIRED",
        "FORBIDDEN"
      ]
    },
    "requirements": {
      "$ref": "./application-identity-profile.v6.schema.json#/$defs/auditabilityRequirements"
    },
    "candidates": {
      "type": "array",
      "minItems": 1,
      "maxItems": 100,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "displayName",
          "analysis",
          "evidence"
        ],
        "properties": {
          "displayName": {
            "type": "string",
            "minLength": 1,
            "maxLength": 120
          },
          "analysis": {
            "$ref": "#/$defs/analysis"
