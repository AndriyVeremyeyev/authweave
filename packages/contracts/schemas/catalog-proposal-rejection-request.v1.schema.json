{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://authweave.dev/contracts/catalog-proposal-rejection-request.v1.schema.json",
  "title": "Curator rejection request v1",
  "type": "object",
  "additionalProperties": false,
  "required": ["expectedVersion", "expectedSha256", "reasonCode"],
  "properties": {
    "expectedVersion": { "type": "integer", "minimum": 0, "maximum": 9007199254740991 },
    "expectedSha256": { "type": "string", "pattern": "^[0-9a-f]{64}$" },
    "reasonCode": {
      "type": "string",
      "enum": ["INSUFFICIENT_EVIDENCE", "INACCURATE_FACTS", "OUT_OF_SCOPE", "OTHER"]
    }
  }
}
