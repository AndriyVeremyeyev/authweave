{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://authweave.dev/contracts/assessment-revision-page.v4.schema.json",
  "title": "Assessment revision page v4",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "items",
    "nextAfterVersion"
  ],
  "properties": {
    "items": {
      "type": "array",
      "maxItems": 100,
      "items": {
        "$ref": "#/$defs/revision"
      }
    },
    "nextAfterVersion": {
      "description": "Exclusive version cursor for the next page, or null when no further rows were found.",
      "type": [
        "integer",
        "null"
      ],
      "minimum": 0,
      "maximum": 9007199254740991
    }
  },
  "$defs": {
    "revision": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "workspaceId",
        "assessmentId",
        "version",
        "status",
        "profileSchemaVersion",
        "profile",
        "origin",
        "recordedAt"
      ],
      "properties": {
        "workspaceId": {
          "type": "string",
          "format": "uuid"
        },
        "assessmentId": {
          "type": "string",
          "format": "uuid"
        },
        "version": {
          "type": "integer",
          "minimum": 0,
          "maximum": 9007199254740991
        },
        "status": {
          "enum": [
            "DRAFT",
            "READY_FOR_EVALUATION",
            "EVALUATED",
            "DECIDED",
            "ARCHIVED"
          ]
        },
        "profileSchemaVersion": {
          "enum": [
            1,
            2,
            3,
            4
          ]
        },
        "profile": {
          "type": "object"
        },
        "origin": {
          "description": "BASELINE records a pre-migration current state; it does not imply earlier revisions were captured.",
          "enum": [
            "CREATED",
            "UPDATED",
            "BASELINE"
          ]
        },
        "recordedAt": {
          "type": "string",
          "format": "date-time"
        }
      },
      "oneOf": [
        {
          "properties": {
            "profileSchemaVersion": {
              "const": 1
            },
            "profile": {
              "$ref": "./application-identity-profile.v1.schema.json"
            }
          }
        },
        {
          "properties": {
            "profileSchemaVersion": {
              "const": 2
            },
            "profile": {
              "$ref": "./application-identity-profile.v2.schema.json"
            }
          }
        },
        {
          "properties": {
            "profileSchemaVersion": {
              "const": 3
            },
            "profile": {
              "$ref": "./application-identity-profile.v3.schema.json"
            }
          }
        },
        {
          "properties": {
            "profileSchemaVersion": {
              "const": 4
            },
            "profile": {
              "$ref": "./application-identity-profile.v4.schema.json"
            }
          }
        }
      ]
    }
  }
}
