                "SATISFIED",
                "NOT_SATISFIED",
                "UNKNOWN"
              ]
            }
          }
        }
      }
    },
    {
      "properties": {
        "patternId": {
          "const": "SERVER_SIDE_SESSION"
        },
        "declarations": {
          "type": "object",
          "additionalProperties": false,
