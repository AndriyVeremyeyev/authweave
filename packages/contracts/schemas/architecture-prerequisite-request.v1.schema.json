                "SATISFIED",
                "NOT_SATISFIED",
                "UNKNOWN"
              ]
            }
          }
        }
      }
    },
    {
      "properties": {
        "patternId": {
          "const": "SPA_CODE_PKCE"
        },
        "declarations": {
          "type": "object",
          "additionalProperties": false,
