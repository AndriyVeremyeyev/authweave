        "BFF_SESSION",
        "SERVER_SIDE_SESSION",
        "SPA_CODE_PKCE",
        "NATIVE_CODE_PKCE",
        "M2M_CLIENT_CREDENTIALS"
      ]
    },
    "declarations": {
      "type": "object",
      "maxProperties": 3
    }
  },
  "oneOf": [
    {
      "properties": {
        "patternId": {
          "const": "BFF_SESSION"
        },
        "declarations": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "BFF_BACKEND_API_PROXY": {
              "type": "string",
              "enum": [
                "SATISFIED",
                "NOT_SATISFIED",
                "UNKNOWN"
              ]
            },
