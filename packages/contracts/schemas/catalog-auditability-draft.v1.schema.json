{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://authweave.dev/contracts/catalog-auditability-draft.v1.schema.json",
  "title": "Unreviewed auditability supplement bound to an exact provider draft v1",
  "description": "Owner-supplied identity-provider claims only. All base options need an exact scope; empty facts mean unknown. Semantic binding and criterion uniqueness are checked by Core. Not the synthetic evidence sidecar, a source review, or a publication.",
  "type": "object", "additionalProperties": false,
  "required": ["schemaVersion", "kind", "evidenceVersion", "baseCatalogVersion", "baseContentSha256", "options"],
  "properties": {
    "schemaVersion": { "const": 1 }, "kind": { "const": "AUDITABILITY_CATALOG_DRAFT" },
    "evidenceVersion": { "$ref": "./provider-catalog-draft.v1.schema.json#/$defs/identifier" },
    "baseCatalogVersion": { "$ref": "./provider-catalog-draft.v1.schema.json#/$defs/identifier" },
    "baseContentSha256": { "$ref": "#/$defs/digest" },
    "options": { "type": "array", "minItems": 1, "maxItems": 100, "uniqueItems": true, "items": { "$ref": "#/$defs/option" } }
  },
  "$defs": {
    "digest": { "type": "string", "pattern": "^[0-9a-f]{64}$" },
    "scope": {
      "type": "object", "additionalProperties": false, "required": ["optionId", "plan", "region", "configuration"],
      "properties": {
        "optionId": { "$ref": "./provider-catalog-draft.v1.schema.json#/$defs/identifier" },
        "plan": { "$ref": "./provider-catalog-draft.v1.schema.json#/$defs/label" },
        "region": { "$ref": "./provider-catalog-draft.v1.schema.json#/$defs/label" },
        "configuration": { "$ref": "./provider-catalog-draft.v1.schema.json#/$defs/label" }
      }
    },
    "option": {
      "type": "object", "additionalProperties": false, "required": ["scope", "facts"],
      "properties": {
        "scope": { "$ref": "#/$defs/scope" },
        "facts": { "type": "array", "maxItems": 6, "uniqueItems": true, "items": { "$ref": "#/$defs/fact" } }
      }
    },
    "criterion": { "enum": ["AUTHENTICATION_SUCCESS_EVENTS", "AUTHENTICATION_FAILURE_EVENTS", "ADMINISTRATIVE_CHANGE_EVENTS", "PROVISIONING_CHANGE_EVENTS", "AUDIT_LOG_EXPORT", "AUDIT_LOG_RETENTION"] },
    "fact": {
      "type": "object", "additionalProperties": false,
      "required": ["emitter", "criterion", "support", "documentedMinimumRetentionDays", "conditions", "evidence"],
      "properties": {
        "emitter": { "const": "IDENTITY_PROVIDER" }, "criterion": { "$ref": "#/$defs/criterion" },
        "support": { "enum": ["SUPPORTED", "UNSUPPORTED", "UNKNOWN"] },
        "documentedMinimumRetentionDays": { "type": ["integer", "null"], "minimum": 0, "maximum": 36500 },
        "conditions": { "$ref": "./provider-catalog-draft.v1.schema.json#/$defs/conditions" },
        "evidence": { "$ref": "./provider-catalog-draft.v1.schema.json#/$defs/evidence" }
      },
      "if": { "properties": { "criterion": { "const": "AUDIT_LOG_RETENTION" }, "support": { "const": "SUPPORTED" } } },
      "else": { "properties": { "documentedMinimumRetentionDays": { "type": "null" } } }
    }
  }
}
