{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://authweave.dev/contracts/catalog-profile-planning-coverage.v1.schema.json",
  "title": "Fresh profile planning coverage composition",
  "description": "Output-only structural v6 coverage plus separate synthetic planning regression bindings. Old structural states and verification gaps remain unchanged. Native and independent HTTP replay enforce exact clocks, sources, complete matrices and digests. No candidate impact, observed verification, approval or publication authority.",
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "evaluatedAt": {"type":"string","format":"date-time"},
    "structuralCoverage": {"$ref":"./catalog-profile-impact-coverage.v1.schema.json","type":"object","properties":{"status":{"const":"INCOMPLETE"}}},
    "regressions": {"type":"array","minItems":4,"maxItems":4,"uniqueItems":true,"items":{"$ref":"#/$defs/binding"}},
    "dimensions": {"type":"array","minItems":136,"maxItems":136,"uniqueItems":true,"items":{"$ref":"#/$defs/dimension"}},
    "verificationGaps": {
      "type": "array",
      "const": [
        {"family":"ARCHITECTURE_CONFIGURATION","boundary":"Observed client registration and actual issuer/redirect values"},
        {"family":"ARCHITECTURE_CONFIGURATION","boundary":"Runtime protocol validation, token storage and session defenses"},
        {"family":"ARCHITECTURE_CONFIGURATION","boundary":"API authorization, scopes, audience and grant permissions"},
        {"family":"ARCHITECTURE_CONFIGURATION","boundary":"Provider interoperability, browser CORS and native redirect ownership"},
        {"family":"ARCHITECTURE_CONFIGURATION","boundary":"Provisioning, offboarding, assurance, compliance and operations"},
        {"family":"ARCHITECTURE_CONFIGURATION","boundary":"Independent assessment of additional resource-access paths"},
        {"family":"PROVISIONING_LIFECYCLE","boundary":"providerOperationsAndEntitlements"},
        {"family":"PROVISIONING_LIFECYCLE","boundary":"observedProvisioningDelivery"},
        {"family":"PROVISIONING_LIFECYCLE","boundary":"groupMembershipAndAuthorization"},
        {"family":"PROVISIONING_LIFECYCLE","boundary":"sessionAndTokenRevocation"},
        {"family":"PROVISIONING_LIFECYCLE","boundary":"reconciliationAndFailureRecovery"},
        {"family":"OPERATIONS_PLANNING","boundary":"Exact provider, plan, region and application-to-identity deployment compatibility"},
        {"family":"OPERATIONS_PLANNING","boundary":"Observed operator capacity, responsibilities, support and recovery exercises"},
        {"family":"OPERATIONS_PLANNING","boundary":"Dated prices, billing-unit mapping, paid features and additional environments"},
        {"family":"OPERATIONS_PLANNING","boundary":"Infrastructure, support, migration and team operational costs"},
        {"family":"OPERATIONS_PLANNING","boundary":"Protocol, lifecycle, auditability, assurance and compliance verification"},
        {"family":"OPERATIONS_PLANNING","boundary":"Provider eligibility, scoring, ranking and final recommendation"},
        {"family":"ASSURANCE_COMPLIANCE","boundary":"Formal assurance framework and level mapping"},
        {"family":"ASSURANCE_COMPLIANCE","boundary":"Observed authentication, enrollment, recovery, session and workload flows"},
        {"family":"ASSURANCE_COMPLIANCE","boundary":"Exact provider and service evidence verification"},
        {"family":"ASSURANCE_COMPLIANCE","boundary":"Legal applicability and target-specific compliance assessment"},
        {"family":"ASSURANCE_COMPLIANCE","boundary":"Candidate-change coverage and publication authority"}
      ]
    },
    "scope": {"const":"CATALOG_PROFILE_PLANNING_COVERAGE"},
    "status": {"const":"INCOMPLETE"},
    "analysisBasis": {"const":"STRUCTURAL_CATALOG_RULES_AND_SEPARATE_SYNTHETIC_PLANNING_REGRESSIONS"},
    "policyVersion": {"const":"catalog-profile-planning-coverage-1"},
    "manifestSha256": {"const":"808c2414bd4617cda4edf6003ed3e12c3d87bfb3ab42c1daf40f4912bb82d08a"},
    "profileSchemaVersion": {"const":6},
    "profileSchemaSha256": {"const":"3d384daf2d98851ebcbe00f90a9c6dabeedbae8361f8a41f58d00b9742c95fbb"},
    "baseScenarioSetSha256": {"const":"ce70ce85cbb2e5b1537f36e2120a5c4add5ef0ce5d64be46397436bbc1993ca1"},
    "auditabilityScenarioSetSha256": {"const":"4cb0bf7ca7372d127eebc98f4a7e06b332df5f347ea75e94928d23b9ba3325f5"},
    "structuralCoverageSha256": {"type":"string","pattern":"^[a-f0-9]{64}$"},
    "analysisSha256": {"type":"string","pattern":"^[a-f0-9]{64}$"},
    "declaredProfileInputs": {"const":34},
    "declaredScenarios": {"const":4},
    "checkedDimensions": {"const":136},
    "checkedRegressionFamilies": {"const":4},
    "planningAddedToDeferredDimensions": {"const":36},
    "unroutedDeferredDimensions": {"const":0},
    "candidateChangesEvaluated": {"const":false},
    "coverageComplete": {"const":false},
    "configurationVerified": {"const":false},
    "lifecycleVerified": {"const":false},
    "operationalReadinessVerified": {"const":false},
    "costModelEvaluated": {"const":false},
    "assuranceVerified": {"const":false},
    "complianceVerified": {"const":false},
    "sourceVerificationPerformed": {"const":false},
    "storedReportVerified": {"const":false},
    "baselineVerified": {"const":false},
    "approvalGranted": {"const":false},
    "publicationReady": {"const":false},
    "evaluationReady": {"const":false},
    "recommendationReady": {"const":false},
    "writesPerformed": {"const":false}
  },
  "$defs": {
