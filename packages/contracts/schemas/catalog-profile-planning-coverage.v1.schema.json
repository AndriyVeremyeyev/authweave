        "policyVersion": {"type":"string"},
        "definitionsSha256": {"type":"string","pattern":"^[a-f0-9]{64}$"},
        "scenarioSetVersion": {"type":"string"},
        "scenarioSetSha256": {"type":"string","pattern":"^[a-f0-9]{64}$"},
        "profileSchemaVersion": {"enum":[5,6]},
        "profileSchemaSha256": {"type":"string","pattern":"^[a-f0-9]{64}$"},
        "analysisSha256": {"type":"string","pattern":"^[a-f0-9]{64}$"},
        "checkSha256": {"type":"string","pattern":"^[a-f0-9]{64}$"},
        "checkedCases": {"type":"integer","minimum":1,"maximum":2016}
      },
      "oneOf": [
        {
          "properties": {
            "family": {"const":"ARCHITECTURE_CONFIGURATION"},
            "policyVersion": {"const":"catalog-architecture-configuration-regression-1"},
            "definitionsSha256": {"const":"c3ada467dbf3d915d20ceb5a2bddb60c3edabc3ac6ac5a70857562e26640a9f9"},
            "scenarioSetVersion": {"const":"catalog-architecture-configuration-scenarios-1"},
            "scenarioSetSha256": {"const":"404fa56ca63260e017beb842cfd53e3ad9328920c06bfa02dfaec065793465ec"},
            "profileSchemaVersion": {"const":5},
            "profileSchemaSha256": {"const":"c995122fdd206e90bdf8145ee76e0e85f657933bb4b91dfae39a6ef715e30561"},
            "checkedCases": {"const":252}
          }
        },
        {
          "properties": {
            "family": {"const":"PROVISIONING_LIFECYCLE"},
            "policyVersion": {"const":"catalog-provisioning-lifecycle-regression-1"},
            "definitionsSha256": {"const":"c81c99b5da95215ab04e06489dec50afa7954bccd065ae68a9179951259b5e1c"},
            "scenarioSetVersion": {"const":"catalog-provisioning-lifecycle-scenarios-1"},
            "scenarioSetSha256": {"const":"bb56c1fb90eca12be7e84b535b0fe70eb3c96386fb09020f04d8d0d4d140e608"},
            "profileSchemaVersion": {"const":6},
            "profileSchemaSha256": {"const":"3d384daf2d98851ebcbe00f90a9c6dabeedbae8361f8a41f58d00b9742c95fbb"},
            "checkedCases": {"const":2016}
          }
        },
        {
          "properties": {
            "family": {"const":"OPERATIONS_PLANNING"},
            "policyVersion": {"const":"catalog-operations-planning-regression-1"},
            "definitionsSha256": {"const":"56448797d617cc284a39d8dfbcfa9105bac739a81b591950f0e2ad9bfecaff83"},
            "scenarioSetVersion": {"const":"catalog-operations-planning-scenarios-1"},
            "scenarioSetSha256": {"const":"8e1f536ba8194d889a08c256972051a37d5e671cf5366a284ab29f6ea61909a3"},
            "profileSchemaVersion": {"const":6},
            "profileSchemaSha256": {"const":"3d384daf2d98851ebcbe00f90a9c6dabeedbae8361f8a41f58d00b9742c95fbb"},
            "checkedCases": {"const":140}
          }
        },
        {
          "properties": {
            "family": {"const":"ASSURANCE_COMPLIANCE"},
            "policyVersion": {"const":"catalog-assurance-compliance-regression-1"},
            "definitionsSha256": {"const":"fd09bce53a9feff6ce79321711fe85f47e6f06b190bc426fe86ad49b86d6cf22"},
            "scenarioSetVersion": {"const":"catalog-assurance-compliance-scenarios-1"},
            "scenarioSetSha256": {"const":"5d8795219810f2b1d94a2de004bbbebf7f7e08d9a0752524906afa035b575378"},
            "profileSchemaVersion": {"const":6},
            "profileSchemaSha256": {"const":"3d384daf2d98851ebcbe00f90a9c6dabeedbae8361f8a41f58d00b9742c95fbb"},
            "checkedCases": {"const":36}
          }
        }
      ]
    },
    "dimension": {
      "type": "object",
      "additionalProperties": false,
      "required": ["scenarioId","profilePath","structuralState","planningRegressions"],
      "properties": {
        "scenarioId": {"$ref":"./catalog-profile-impact-coverage.v1.schema.json#/$defs/scenarioId"},
        "profilePath": {"$ref":"./catalog-profile-impact-coverage.v1.schema.json#/$defs/profilePath"},
        "structuralState": {"$ref":"./catalog-profile-impact-coverage.v1.schema.json#/$defs/dimension/properties/state"},
        "planningRegressions": {"type":"array","maxItems":2,"uniqueItems":true,"items":{"enum":["ARCHITECTURE_CONFIGURATION","PROVISIONING_LIFECYCLE","OPERATIONS_PLANNING","ASSURANCE_COMPLIANCE"]}}
      },
      "oneOf": [
        {"properties":{"profilePath":{"const":"application.clients"},"planningRegressions":{"const":["ARCHITECTURE_CONFIGURATION","ASSURANCE_COMPLIANCE"]}}},
        {"properties":{"profilePath":{"const":"application.type"},"planningRegressions":{"const":[]}}},
        {"properties":{"profilePath":{"const":"audience.membership"},"planningRegressions":{"const":[]}}},
        {"properties":{"profilePath":{"const":"audience.populations"},"planningRegressions":{"const":["ASSURANCE_COMPLIANCE"]}}},
        {"properties":{"profilePath":{"const":"audience.tenancy"},"planningRegressions":{"const":[]}}},
        {"properties":{"profilePath":{"const":"operations.budgetSensitivity"},"planningRegressions":{"const":["OPERATIONS_PLANNING"]}}},
        {"properties":{"profilePath":{"const":"operations.deploymentTarget"},"planningRegressions":{"const":["OPERATIONS_PLANNING"]}}},
        {"properties":{"profilePath":{"const":"operations.hosting"},"planningRegressions":{"const":["OPERATIONS_PLANNING"]}}},
        {"properties":{"profilePath":{"const":"operations.identityExpertise"},"planningRegressions":{"const":["OPERATIONS_PLANNING"]}}},
        {"properties":{"profilePath":{"const":"operations.usagePlanning.assumptions"},"planningRegressions":{"const":["OPERATIONS_PLANNING"]}}},
        {"properties":{"profilePath":{"const":"operations.usagePlanning.scopeDescription"},"planningRegressions":{"const":["OPERATIONS_PLANNING"]}}},
        {"properties":{"profilePath":{"const":"operations.usagePlanning.volumes"},"planningRegressions":{"const":["OPERATIONS_PLANNING"]}}},
        {"properties":{"profilePath":{"const":"protocols.enterpriseSingleSignOn"},"planningRegressions":{"const":[]}}},
        {"properties":{"profilePath":{"const":"protocols.federation.OIDC"},"planningRegressions":{"const":[]}}},
        {"properties":{"profilePath":{"const":"protocols.federation.SAML"},"planningRegressions":{"const":[]}}},
        {"properties":{"profilePath":{"const":"protocols.oauth2ProtectedApis"},"planningRegressions":{"const":[]}}},
        {"properties":{"profilePath":{"const":"protocols.socialLogin"},"planningRegressions":{"const":[]}}},
        {"properties":{"profilePath":{"const":"provisioning.groupSynchronization"},"planningRegressions":{"const":["PROVISIONING_LIFECYCLE"]}}},
        {"properties":{"profilePath":{"const":"provisioning.justInTimeProvisioning"},"planningRegressions":{"const":["PROVISIONING_LIFECYCLE"]}}},
        {"properties":{"profilePath":{"const":"provisioning.scim"},"planningRegressions":{"const":["PROVISIONING_LIFECYCLE"]}}},
        {"properties":{"profilePath":{"const":"security.assurance"},"planningRegressions":{"const":["ASSURANCE_COMPLIANCE"]}}},
        {"properties":{"profilePath":{"const":"security.auditability"},"planningRegressions":{"const":[]}}},
        {"properties":{"profilePath":{"const":"security.auditabilityRequirements.minimumRetentionDays"},"planningRegressions":{"const":[]}}},
        {"properties":{"profilePath":{"const":"security.auditabilityRequirements.selectedCriteria"},"planningRegressions":{"const":[]}}},
        {"properties":{"profilePath":{"const":"security.authenticationControls.nonExportableKeys"},"planningRegressions":{"const":["ASSURANCE_COMPLIANCE"]}}},
        {"properties":{"profilePath":{"const":"security.authenticationControls.phishingResistance"},"planningRegressions":{"const":["ASSURANCE_COMPLIANCE"]}}},
        {"properties":{"profilePath":{"const":"security.authenticationControls.stepUpAuthentication"},"planningRegressions":{"const":["ASSURANCE_COMPLIANCE"]}}},
        {"properties":{"profilePath":{"const":"security.browserTokenExposureMinimization"},"planningRegressions":{"const":["ARCHITECTURE_CONFIGURATION"]}}},
        {"properties":{"profilePath":{"const":"security.complianceScopeStatus"},"planningRegressions":{"const":["ASSURANCE_COMPLIANCE"]}}},
        {"properties":{"profilePath":{"const":"security.complianceTargets"},"planningRegressions":{"const":["ASSURANCE_COMPLIANCE"]}}},
        {"properties":{"profilePath":{"const":"security.dataResidency"},"planningRegressions":{"const":[]}}},
        {"properties":{"profilePath":{"const":"security.dataResidencyDetails.allowedCountries"},"planningRegressions":{"const":[]}}},
        {"properties":{"profilePath":{"const":"security.dataResidencyDetails.dataCategories"},"planningRegressions":{"const":[]}}},
        {"properties":{"profilePath":{"const":"security.multiFactorAuthentication"},"planningRegressions":{"const":["ASSURANCE_COMPLIANCE"]}}}
      ]
    }
  },
  "required": [
    "evaluatedAt",
    "structuralCoverage",
    "regressions",
    "dimensions",
    "verificationGaps",
    "scope",
    "status",
