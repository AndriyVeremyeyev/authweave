    "unroutedDeferredDimensions",
    "candidateChangesEvaluated",
    "coverageComplete",
    "configurationVerified",
    "lifecycleVerified",
    "operationalReadinessVerified",
    "costModelEvaluated",
    "assuranceVerified",
