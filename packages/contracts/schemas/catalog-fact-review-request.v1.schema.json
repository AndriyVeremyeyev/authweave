{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://authweave.dev/contracts/catalog-fact-review-request.v1.schema.json",
  "title": "Explicit candidate fact source review request v1",
  "description": "The curator explicitly chooses personal manual review or endorsement of an assistant-prepared conclusion. Owner endorsement does not claim personal source reading or authenticated assistant provenance. Neither mode fetches or independently verifies a source, approves publication or promotes fact trust. Exact retries bind the same actor, payload and origin.",
  "type": "object",
  "additionalProperties": false,
  "required": ["reviewId", "expectedVersion", "expectedSha256", "optionId", "factPath", "verdict", "confirmation"],
  "properties": {
    "reviewId": { "type": "string", "format": "uuid" },
    "expectedVersion": { "type": "integer", "minimum": 0, "maximum": 9007199254740991 },
    "expectedSha256": { "type": "string", "pattern": "^[0-9a-f]{64}$" },
    "optionId": { "type": "string", "pattern": "^[a-z0-9][a-z0-9.-]{0,99}$" },
    "factPath": { "type": "string", "maxLength": 200, "pattern": "^(facts\\.[A-Z0-9_]+|compatibility\\.(applications|clients|populations|tenancy|membership)\\.[A-Z0-9_]+|residency\\.[A-Z0-9_]+|authenticationControls\\.[A-Z0-9_]+\\.[A-Z0-9_]+\\.[A-Z0-9_]+)$" },
    "verdict": { "type": "string", "enum": ["SOURCE_SUPPORTS_CLAIM", "SOURCE_DOES_NOT_SUPPORT_CLAIM", "INSUFFICIENT_EVIDENCE"] },
    "confirmation": { "enum": ["MANUAL_SOURCE_REVIEW", "OWNER_APPROVES_ASSISTANT_SOURCE_ASSESSMENT"] }
  }
}
