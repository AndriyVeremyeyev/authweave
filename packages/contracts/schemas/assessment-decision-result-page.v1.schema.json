{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://authweave.dev/contracts/assessment-decision-result-page.v1.schema.json",
  "title": "Owned immutable decision result discovery page v1",
  "description": "Bounded newest-first metadata only. A reference is not a replay or source verification. All-or-none exact before reference scopes keyset pagination to one owned assessment; new results never change older pages.",
  "type": "object", "additionalProperties": false,
  "required": ["scope", "workspaceId", "assessmentId", "items", "nextBefore", "historicalReplayVerified"],
  "properties": {
    "scope": { "const": "OWNED_ASSESSMENT_RESULT_INDEX" },
    "workspaceId": { "type": "string", "format": "uuid" }, "assessmentId": { "type": "string", "format": "uuid" },
    "items": { "type": "array", "maxItems": 20, "items": { "$ref": "#/$defs/item" } },
    "nextBefore": { "anyOf": [{ "type": "null" }, { "$ref": "assessment-decision-result-request.v1.schema.json#/$defs/reference" }] },
    "historicalReplayVerified": { "const": false }
  },
  "$defs": {
    "item": { "type": "object", "additionalProperties": false,
      "required": ["reference", "assessmentVersion", "catalog", "previousResult", "recordedAt"],
      "properties": {
        "reference": { "$ref": "assessment-decision-result-request.v1.schema.json#/$defs/reference" },
        "assessmentVersion": { "type": "integer", "minimum": 0, "maximum": 9007199254740991 },
        "catalog": { "$ref": "catalog-baseline-reference.v1.schema.json" },
        "previousResult": { "anyOf": [{ "type": "null" }, { "$ref": "assessment-decision-result-request.v1.schema.json#/$defs/reference" }] },
        "recordedAt": { "type": "string", "format": "date-time" }
      }
    }
  }
}
