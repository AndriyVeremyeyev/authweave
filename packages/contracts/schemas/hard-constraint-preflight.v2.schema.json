{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://authweave.dev/contracts/hard-constraint-preflight.v2.schema.json",
  "title": "Synthetic hard constraints with scoped auditability v2",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "workspaceId",
    "assessmentId",
    "assessmentVersion",
    "catalogVersion",
    "catalogKind",
    "policyVersion",
    "evaluatedAt",
    "scope",
    "recommendationReady",
    "deferredPaths",
    "candidates",
    "auditability"
  ],
  "properties": {
    "workspaceId": {
      "$ref": "./hard-constraint-preflight.v1.schema.json#/properties/workspaceId"
    },
    "assessmentId": {
      "$ref": "./hard-constraint-preflight.v1.schema.json#/properties/assessmentId"
    },
    "assessmentVersion": {
      "$ref": "./hard-constraint-preflight.v1.schema.json#/properties/assessmentVersion"
    },
    "catalogVersion": {
      "$ref": "./hard-constraint-preflight.v1.schema.json#/properties/catalogVersion"
    },
    "catalogKind": {
      "$ref": "./hard-constraint-preflight.v1.schema.json#/properties/catalogKind"
    },
    "evaluatedAt": {
      "$ref": "./hard-constraint-preflight.v1.schema.json#/properties/evaluatedAt"
    },
    "scope": {
      "$ref": "./hard-constraint-preflight.v1.schema.json#/properties/scope"
    },
    "recommendationReady": {
      "$ref": "./hard-constraint-preflight.v1.schema.json#/properties/recommendationReady"
    },
    "deferredPaths": {
      "$ref": "./hard-constraint-preflight.v1.schema.json#/properties/deferredPaths"
    },
    "policyVersion": {
      "const": "hard-constraint-preflight-2"
    },
    "auditability": {
      "$ref": "./auditability-capability-preflight.v1.schema.json"
    },
    "candidates": {
      "type": "array",
      "minItems": 1,
      "maxItems": 100,
      "items": {
        "$ref": "#/$defs/candidate"
      }
    }
  },
  "$defs": {
    "candidate": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "optionId",
        "displayName",
        "plan",
        "region",
        "verdict",
        "exclusionReasons",
        "informationGaps"
      ],
      "properties": {
        "optionId": {
          "$ref": "./hard-constraint-preflight.v1.schema.json#/$defs/candidate/properties/optionId"
        },
        "displayName": {
          "$ref": "./hard-constraint-preflight.v1.schema.json#/$defs/candidate/properties/displayName"
        },
        "plan": {
          "$ref": "./hard-constraint-preflight.v1.schema.json#/$defs/candidate/properties/plan"
        },
        "region": {
          "$ref": "./hard-constraint-preflight.v1.schema.json#/$defs/candidate/properties/region"
        },
        "verdict": {
          "$ref": "./hard-constraint-preflight.v1.schema.json#/$defs/candidate/properties/verdict"
        },
        "exclusionReasons": {
          "type": "array",
          "maxItems": 500,
          "items": {
            "$ref": "#/$defs/finding"
          }
        },
        "informationGaps": {
          "type": "array",
          "maxItems": 500,
          "items": {
            "$ref": "#/$defs/finding"
          }
        }
      }
    },
    "finding": {
      "oneOf": [
        {
          "$ref": "./hard-constraint-preflight.v1.schema.json#/$defs/finding"
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "dimension",
            "profilePath",
            "reasonCode",
            "explanation"
          ],
          "properties": {
            "dimension": {
              "const": "AUDITABILITY"
            },
            "profilePath": {
              "enum": [
                "security.auditability",
                "security.auditabilityRequirements"
              ]
            },
            "reasonCode": {
              "enum": [
                "REQUIREMENT_UNKNOWN",
                "AUDIT_INTENT_UNCLEAR",
                "AUDIT_SCOPE_UNKNOWN",
                "EVIDENCE_MISSING",
                "EVIDENCE_UNREVIEWED",
                "EVIDENCE_FROM_FUTURE",
                "EVIDENCE_STALE",
                "CAPABILITY_UNKNOWN",
                "CAPABILITY_UNAVAILABLE",
                "RETENTION_DURATION_UNKNOWN",
                "RETENTION_BELOW_MINIMUM"
              ]
            },
            "explanation": {
              "$ref": "./hard-constraint-preflight.v1.schema.json#/$defs/finding/properties/explanation"
            }
          }
        }
      ]
    }
  },
  "description": "One saved assessment and evaluation instant. Auditability failures exclude; unknown evidence remains unresolved. The embedded exact scoped evidence is synthetic, not deployed logging, compliance, source verification or publication approval. Legacy v1 is unchanged."
}
