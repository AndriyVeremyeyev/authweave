{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://authweave.dev/contracts/assessment-event-page.v1.schema.json",
  "title": "Assessment event page v1",
  "type": "object",
  "additionalProperties": false,
  "required": ["items", "nextAfterVersion"],
  "properties": {
    "items": {
      "type": "array",
      "maxItems": 100,
      "items": { "$ref": "#/$defs/event" }
    },
    "nextAfterVersion": { "type": ["integer", "null"], "minimum": 0, "maximum": 9007199254740991 }
  },
  "$defs": {
    "event": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "workspaceId", "assessmentId", "version", "previousVersion", "action", "actorType", "actorId", "correlationId", "outcome", "changedSections", "occurredAt"],
      "properties": {
        "id": { "type": "string", "format": "uuid" },
        "workspaceId": { "type": "string", "format": "uuid" },
        "assessmentId": { "type": "string", "format": "uuid" },
        "version": { "type": "integer", "minimum": 0, "maximum": 9007199254740991 },
        "previousVersion": { "type": ["integer", "null"], "minimum": 0, "maximum": 9007199254740991 },
        "action": { "enum": ["assessment.created", "assessment.updated", "assessment.baseline"] },
        "actorType": { "enum": ["SERVICE", "MIGRATION"] },
        "actorId": { "type": "string", "minLength": 1, "maxLength": 64 },
        "correlationId": {
          "description": "Server-generated identifier for this committed mutation, not an authenticated identity or end-to-end request trace.",
          "type": "string", "format": "uuid"
        },
        "outcome": { "const": "SUCCEEDED" },
        "changedSections": {
          "description": "Section names only; profile values belong to the revision snapshot, not the event.",
          "type": "array", "maxItems": 7, "uniqueItems": true,
          "items": { "enum": ["status", "application", "audience", "protocols", "provisioning", "security", "operations"] }
        },
        "occurredAt": { "type": "string", "format": "date-time" }
      }
    }
  }
}
