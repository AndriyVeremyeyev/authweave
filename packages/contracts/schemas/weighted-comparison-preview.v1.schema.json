{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://authweave.dev/contracts/weighted-comparison-preview.v1.schema.json",
  "title": "Explicitly weighted synthetic comparison preview v1",
  "type": "object",
  "additionalProperties": false,
  "required": ["comparison", "scoringPolicyVersion", "weights", "rankingPerformed", "recommendationReady", "scores"],
  "properties": {
    "comparison": { "$ref": "./synthetic-comparison.v1.schema.json" },
    "scoringPolicyVersion": { "const": "explicit-capability-weights-1" },
    "weights": { "$ref": "./weighted-comparison-request.v1.schema.json#/$defs/weights" },
    "rankingPerformed": { "const": false },
    "recommendationReady": { "const": false },
    "scores": { "type": "array", "minItems": 1, "maxItems": 100, "items": { "$ref": "#/$defs/candidateScore" } }
  },
  "$defs": {
    "candidateScore": {
      "type": "object",
      "additionalProperties": false,
      "required": ["optionId", "status", "score", "contributions"],
      "properties": {
        "optionId": { "$ref": "./synthetic-provider-catalog.v1.schema.json#/$defs/identifier" },
        "status": { "enum": ["SCORED", "EXCLUDED", "UNRESOLVED_HARD_CONSTRAINTS", "UNKNOWN_PREFERENCE_EVIDENCE"] },
        "score": { "type": ["integer", "null"], "minimum": 0, "maximum": 100 },
        "contributions": { "type": "array", "maxItems": 9, "items": { "$ref": "#/$defs/contribution" } }
      },
      "if": { "properties": { "status": { "const": "SCORED" } }, "required": ["status"] },
      "then": { "properties": { "score": { "type": "integer" }, "contributions": { "type": "array", "minItems": 1 } } },
      "else": { "properties": { "score": { "type": "null" }, "contributions": { "type": "array", "maxItems": 0 } } }
    },
    "contribution": {
      "type": "object",
      "additionalProperties": false,
      "required": ["capability", "weight", "outcome", "earnedPoints"],
      "properties": {
        "capability": { "$ref": "./capability-preflight.v1.schema.json#/$defs/check/properties/capability" },
        "weight": { "type": "integer", "minimum": 1, "maximum": 100 },
        "outcome": { "enum": ["AVAILABLE", "UNAVAILABLE"] },
        "earnedPoints": { "type": "integer", "minimum": 0, "maximum": 100 }
      }
    }
  },
  "description": "A diagnostic score only for synthetic options that pass checked hard requirements and have known preferred-capability evidence. No ranking, winner, default weights, or final recommendation. Deferred dimensions are not scored."
}
