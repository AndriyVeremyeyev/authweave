{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://authweave.dev/contracts/synthetic-provider-catalog.v4.schema.json",
  "title": "Synthetic provider catalog v4",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "catalogVersion",
    "kind",
    "options"
  ],
  "properties": {
    "schemaVersion": {
      "const": 4
    },
    "catalogVersion": {
      "$ref": "#/$defs/identifier"
    },
    "kind": {
      "const": "SYNTHETIC"
    },
    "options": {
      "type": "array",
      "minItems": 1,
      "maxItems": 100,
      "items": {
        "$ref": "#/$defs/option"
      }
    }
  },
  "$defs": {
    "identifier": {
      "type": "string",
      "pattern": "^[a-z0-9][a-z0-9.-]{0,99}$"
    },
    "label": {
      "type": "string",
      "minLength": 1,
      "maxLength": 120,
      "pattern": "\\S"
    },
    "capability": {
      "type": "string",
      "enum": [
        "OIDC",
        "SAML",
        "OAUTH2_APIS",
        "SOCIAL_LOGIN",
        "ENTERPRISE_SSO",
        "SCIM",
        "JIT",
        "GROUP_SYNC",
        "MFA"
      ]
    },
    "fact": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "availability",
        "evidenceStatus",
        "sourceUrl",
        "observedAt"
      ],
      "properties": {
        "availability": {
          "enum": [
            "OPTIONAL",
            "MANDATORY",
            "UNAVAILABLE",
            "UNKNOWN"
          ]
        },
        "evidenceStatus": {
          "enum": [
            "REVIEWED",
            "UNREVIEWED"
          ]
        },
        "sourceUrl": {
          "type": "string",
          "format": "uri",
          "maxLength": 2048,
          "pattern": "^https://[A-Za-z0-9.-]+\\.invalid(?::[0-9]+)?(?:[/?#][^\\s]*)?$"
        },
        "observedAt": {
          "type": "string",
          "format": "date-time"
        }
      }
    },
    "option": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "displayName",
        "plan",
        "region",
        "facts",
        "compatibility",
        "residency",
        "authenticationControls"
      ],
      "properties": {
        "id": {
          "$ref": "#/$defs/identifier"
        },
        "displayName": {
          "$ref": "#/$defs/label"
        },
        "plan": {
          "$ref": "#/$defs/label"
        },
        "region": {
          "$ref": "#/$defs/label"
        },
        "facts": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "OIDC": {
              "$ref": "#/$defs/fact"
            },
            "SAML": {
              "$ref": "#/$defs/fact"
            },
            "OAUTH2_APIS": {
              "$ref": "#/$defs/fact"
            },
            "SOCIAL_LOGIN": {
              "$ref": "#/$defs/fact"
            },
            "ENTERPRISE_SSO": {
              "$ref": "#/$defs/fact"
            },
            "SCIM": {
              "$ref": "#/$defs/fact"
            },
            "JIT": {
              "$ref": "#/$defs/fact"
            },
            "GROUP_SYNC": {
              "$ref": "#/$defs/fact"
            },
            "MFA": {
              "$ref": "#/$defs/fact"
            }
          }
        },
        "compatibility": {
          "$ref": "#/$defs/compatibility"
        },
        "residency": {
          "description": "Category-specific at-rest destinations for this exact option. No inference from the region label; an absent category is unknown.",
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "USER_PROFILES": {
              "$ref": "#/$defs/residencyFact"
            },
            "CREDENTIALS": {
              "$ref": "#/$defs/residencyFact"
            },
            "AUDIT_LOGS": {
              "$ref": "#/$defs/residencyFact"
            },
            "BACKUPS": {
              "$ref": "#/$defs/residencyFact"
            }
          }
        },
        "authenticationControls": {
          "$ref": "#/$defs/authenticationControls"
        }
      }
    },
    "compatibilityFact": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "support",
        "evidenceStatus",
        "sourceUrl",
        "observedAt"
      ],
      "properties": {
        "evidenceStatus": {
          "enum": [
            "REVIEWED",
            "UNREVIEWED"
          ]
        },
        "sourceUrl": {
          "type": "string",
          "format": "uri",
          "maxLength": 2048,
          "pattern": "^https://[A-Za-z0-9.-]+\\.invalid(?::[0-9]+)?(?:[/?#][^\\s]*)?$"
        },
        "observedAt": {
          "type": "string",
          "format": "date-time"
        },
        "support": {
          "enum": [
            "SUPPORTED",
            "UNSUPPORTED",
            "UNKNOWN"
          ]
        }
      }
    },
    "compatibility": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "applications",
        "clients",
        "populations",
        "tenancy",
        "membership"
      ],
      "properties": {
        "applications": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "B2B_SAAS": {
              "$ref": "#/$defs/compatibilityFact"
            },
            "PARTNER_PORTAL": {
              "$ref": "#/$defs/compatibilityFact"
            },
            "PUBLIC_SECTOR_PORTAL": {
              "$ref": "#/$defs/compatibilityFact"
            },
            "INTERNAL_WORKFORCE": {
              "$ref": "#/$defs/compatibilityFact"
            }
          }
        },
        "clients": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "BROWSER": {
              "$ref": "#/$defs/compatibilityFact"
            },
            "NATIVE_MOBILE": {
              "$ref": "#/$defs/compatibilityFact"
            },
            "MACHINE_TO_MACHINE": {
              "$ref": "#/$defs/compatibilityFact"
            }
          }
        },
        "populations": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "EXTERNAL_CUSTOMERS": {
              "$ref": "#/$defs/compatibilityFact"
            },
            "PARTNERS": {
              "$ref": "#/$defs/compatibilityFact"
            },
            "CITIZENS": {
              "$ref": "#/$defs/compatibilityFact"
            },
            "EMPLOYEES": {
              "$ref": "#/$defs/compatibilityFact"
            },
            "CONTRACTORS": {
              "$ref": "#/$defs/compatibilityFact"
            },
            "INTERNAL_OPERATORS": {
              "$ref": "#/$defs/compatibilityFact"
            }
          }
        },
        "tenancy": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "MULTI_TENANT_ORGANIZATIONS": {
              "$ref": "#/$defs/compatibilityFact"
            },
            "SINGLE_ORGANIZATION": {
              "$ref": "#/$defs/compatibilityFact"
            },
            "NO_ORGANIZATION_BOUNDARY": {
              "$ref": "#/$defs/compatibilityFact"
            }
          }
        },
        "membership": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "SINGLE_ORGANIZATION_PER_USER": {
              "$ref": "#/$defs/compatibilityFact"
            },
            "MULTIPLE_ORGANIZATIONS_PER_USER": {
              "$ref": "#/$defs/compatibilityFact"
            },
            "NOT_APPLICABLE": {
              "$ref": "#/$defs/compatibilityFact"
            }
          }
        }
      }
    },
    "residencyFact": {
      "description": "Confirmed storage destinations for this configured option, not selectable alternatives. COMPLETE covers all destinations for the category, including replicas. Recovery copies belong to BACKUPS, separately from primary profile/credential/log storage. PARTIAL lists confirmed destinations but cannot rule out others. UNKNOWN has no countries; empty lists never establish absence of storage. Different placement choices require separate catalog options. This is not processing, support-access, transfer or compliance evidence.",
      "type": "object",
      "additionalProperties": false,
      "required": [
        "coverage",
        "storageCountries",
        "evidenceStatus",
        "sourceUrl",
        "observedAt"
      ],
      "properties": {
        "coverage": {
          "enum": [
            "COMPLETE",
            "PARTIAL",
            "UNKNOWN"
          ]
        },
        "storageCountries": {
          "type": "array",
          "maxItems": 249,
          "uniqueItems": true,
          "items": {
            "type": "string",
            "pattern": "^[A-Z]{2}$"
          }
        },
        "evidenceStatus": {
          "enum": [
            "REVIEWED",
            "UNREVIEWED"
          ]
        },
        "sourceUrl": {
          "type": "string",
          "format": "uri",
          "maxLength": 2048,
          "pattern": "^https://[A-Za-z0-9.-]+\\.invalid(?::[0-9]+)?(?:[/?#][^\\s]*)?$"
        },
        "observedAt": {
          "type": "string",
          "format": "date-time"
        }
      },
      "allOf": [
        {
          "if": {
            "properties": {
              "coverage": {
                "const": "UNKNOWN"
              }
            }
          },
          "then": {
            "properties": {
              "storageCountries": {
                "type": "array",
                "maxItems": 0
              }
            }
          },
          "else": {
            "properties": {
              "storageCountries": {
                "type": "array",
                "minItems": 1
              }
            }
          }
        }
      ]
    },
    "authenticationControlFact": {
      "description": "Scoped human-flow capability for this exact plan/region, client and population. Availability means the control can be offered; enforcement means the flow can require it without a weaker ordinary-login fallback. Phishing resistance requires verifier binding; non-exportable keys require protected non-exportable authenticators, not merely unsynced passkeys; step-up requires requesting and verifying stronger authentication. This does not prove deployed settings, action wiring, enrollment/recovery/session security or an AAL.",
      "type": "object",
      "additionalProperties": false,
      "required": [
        "availability",
        "enforcement",
        "evidenceStatus",
        "sourceUrl",
        "observedAt"
      ],
      "properties": {
        "availability": {
          "enum": [
            "SUPPORTED",
            "UNSUPPORTED",
            "UNKNOWN"
          ]
        },
        "enforcement": {
          "enum": [
            "SUPPORTED",
            "UNSUPPORTED",
            "UNKNOWN"
          ]
        },
        "evidenceStatus": {
          "enum": [
            "REVIEWED",
            "UNREVIEWED"
          ]
        },
        "sourceUrl": {
          "type": "string",
          "format": "uri",
          "maxLength": 2048,
          "pattern": "^https://[A-Za-z0-9.-]+\\.invalid(?::[0-9]+)?(?:[/?#][^\\s]*)?$"
        },
        "observedAt": {
          "type": "string",
          "format": "date-time"
        }
      },
      "allOf": [
        {
          "if": {
            "properties": {
              "enforcement": {
                "const": "SUPPORTED"
              }
            }
          },
          "then": {
            "properties": {
              "availability": {
                "const": "SUPPORTED"
              }
            }
          }
        }
      ]
    },
    "authenticationControls": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "BROWSER": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "EXTERNAL_CUSTOMERS": {
              "type": "object",
              "additionalProperties": false,
              "properties": {
                "PHISHING_RESISTANCE": {
                  "$ref": "#/$defs/authenticationControlFact"
                },
                "NON_EXPORTABLE_KEYS": {
                  "$ref": "#/$defs/authenticationControlFact"
                },
                "STEP_UP_AUTHENTICATION": {
                  "$ref": "#/$defs/authenticationControlFact"
                }
              }
            },
            "PARTNERS": {
              "type": "object",
              "additionalProperties": false,
              "properties": {
                "PHISHING_RESISTANCE": {
                  "$ref": "#/$defs/authenticationControlFact"
                },
                "NON_EXPORTABLE_KEYS": {
                  "$ref": "#/$defs/authenticationControlFact"
                },
                "STEP_UP_AUTHENTICATION": {
                  "$ref": "#/$defs/authenticationControlFact"
                }
              }
            },
            "CITIZENS": {
              "type": "object",
              "additionalProperties": false,
              "properties": {
                "PHISHING_RESISTANCE": {
                  "$ref": "#/$defs/authenticationControlFact"
                },
                "NON_EXPORTABLE_KEYS": {
                  "$ref": "#/$defs/authenticationControlFact"
                },
                "STEP_UP_AUTHENTICATION": {
                  "$ref": "#/$defs/authenticationControlFact"
                }
              }
            },
            "EMPLOYEES": {
              "type": "object",
              "additionalProperties": false,
              "properties": {
                "PHISHING_RESISTANCE": {
                  "$ref": "#/$defs/authenticationControlFact"
                },
                "NON_EXPORTABLE_KEYS": {
                  "$ref": "#/$defs/authenticationControlFact"
                },
                "STEP_UP_AUTHENTICATION": {
                  "$ref": "#/$defs/authenticationControlFact"
                }
              }
            },
            "CONTRACTORS": {
              "type": "object",
              "additionalProperties": false,
              "properties": {
                "PHISHING_RESISTANCE": {
                  "$ref": "#/$defs/authenticationControlFact"
                },
                "NON_EXPORTABLE_KEYS": {
                  "$ref": "#/$defs/authenticationControlFact"
                },
                "STEP_UP_AUTHENTICATION": {
                  "$ref": "#/$defs/authenticationControlFact"
                }
              }
            },
            "INTERNAL_OPERATORS": {
              "type": "object",
              "additionalProperties": false,
              "properties": {
                "PHISHING_RESISTANCE": {
                  "$ref": "#/$defs/authenticationControlFact"
                },
                "NON_EXPORTABLE_KEYS": {
                  "$ref": "#/$defs/authenticationControlFact"
                },
                "STEP_UP_AUTHENTICATION": {
                  "$ref": "#/$defs/authenticationControlFact"
                }
              }
            }
          }
        },
        "NATIVE_MOBILE": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "EXTERNAL_CUSTOMERS": {
              "type": "object",
              "additionalProperties": false,
              "properties": {
                "PHISHING_RESISTANCE": {
                  "$ref": "#/$defs/authenticationControlFact"
                },
                "NON_EXPORTABLE_KEYS": {
                  "$ref": "#/$defs/authenticationControlFact"
                },
                "STEP_UP_AUTHENTICATION": {
                  "$ref": "#/$defs/authenticationControlFact"
                }
              }
            },
            "PARTNERS": {
              "type": "object",
              "additionalProperties": false,
              "properties": {
                "PHISHING_RESISTANCE": {
                  "$ref": "#/$defs/authenticationControlFact"
                },
                "NON_EXPORTABLE_KEYS": {
                  "$ref": "#/$defs/authenticationControlFact"
                },
                "STEP_UP_AUTHENTICATION": {
                  "$ref": "#/$defs/authenticationControlFact"
                }
              }
            },
            "CITIZENS": {
              "type": "object",
              "additionalProperties": false,
              "properties": {
                "PHISHING_RESISTANCE": {
                  "$ref": "#/$defs/authenticationControlFact"
                },
                "NON_EXPORTABLE_KEYS": {
                  "$ref": "#/$defs/authenticationControlFact"
                },
                "STEP_UP_AUTHENTICATION": {
                  "$ref": "#/$defs/authenticationControlFact"
                }
              }
            },
            "EMPLOYEES": {
              "type": "object",
              "additionalProperties": false,
              "properties": {
                "PHISHING_RESISTANCE": {
                  "$ref": "#/$defs/authenticationControlFact"
                },
                "NON_EXPORTABLE_KEYS": {
                  "$ref": "#/$defs/authenticationControlFact"
                },
                "STEP_UP_AUTHENTICATION": {
                  "$ref": "#/$defs/authenticationControlFact"
                }
              }
            },
            "CONTRACTORS": {
              "type": "object",
              "additionalProperties": false,
              "properties": {
                "PHISHING_RESISTANCE": {
                  "$ref": "#/$defs/authenticationControlFact"
                },
                "NON_EXPORTABLE_KEYS": {
                  "$ref": "#/$defs/authenticationControlFact"
                },
                "STEP_UP_AUTHENTICATION": {
                  "$ref": "#/$defs/authenticationControlFact"
                }
              }
            },
            "INTERNAL_OPERATORS": {
              "type": "object",
              "additionalProperties": false,
              "properties": {
                "PHISHING_RESISTANCE": {
                  "$ref": "#/$defs/authenticationControlFact"
                },
                "NON_EXPORTABLE_KEYS": {
                  "$ref": "#/$defs/authenticationControlFact"
                },
                "STEP_UP_AUTHENTICATION": {
                  "$ref": "#/$defs/authenticationControlFact"
                }
              }
            }
          }
        }
      }
    }
  }
}
