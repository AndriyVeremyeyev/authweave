{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://authweave.dev/contracts/provisioning-lifecycle-request.v1.schema.json",
  "title": "Temporary provisioning lifecycle design selection",
  "type": "object",
  "additionalProperties": false,
  "required": ["expectedVersion","patternId","declarations"],
  "properties": {
    "expectedVersion": {"type":"integer","minimum":0,"maximum":9007199254740991},
    "patternId": {"$ref":"#/$defs/patternId"},
    "declarations": {"type":"object","maxProperties":8}
  },
  "allOf": [{"$ref":"#/$defs/selection"}],
  "$defs": {
    "patternId": {"type":"string","enum":["SCIM_PUSH","JIT_LOGIN","SCIM_AND_JIT"]},
    "declaration": {"type":"string","enum":["SATISFIED","NOT_SATISFIED","UNKNOWN"]},
    "selection": {
      "type": "object",
      "oneOf": [
        {
          "properties": {
            "patternId": {"const":"SCIM_PUSH"},
            "declarations": {
              "type": "object",
              "additionalProperties": false,
              "maxProperties": 6,
              "properties": {
                "TENANT_AND_SUBJECT_CORRELATION": {"$ref":"#/$defs/declaration"},
                "ATTRIBUTE_OWNERSHIP_AND_MAPPING": {"$ref":"#/$defs/declaration"},
                "OFFBOARDING_AND_ACCESS_REVOCATION": {"$ref":"#/$defs/declaration"},
                "FAILURE_RECOVERY_AND_RECONCILIATION": {"$ref":"#/$defs/declaration"},
                "SCIM_CLIENT_SERVER_DIRECTION": {"$ref":"#/$defs/declaration"},
                "SCIM_USER_OPERATIONS": {"$ref":"#/$defs/declaration"}
              }
            }
          }
        },
        {
          "properties": {
            "patternId": {"const":"JIT_LOGIN"},
            "declarations": {
              "type": "object",
              "additionalProperties": false,
              "maxProperties": 5,
              "properties": {
                "TENANT_AND_SUBJECT_CORRELATION": {"$ref":"#/$defs/declaration"},
                "ATTRIBUTE_OWNERSHIP_AND_MAPPING": {"$ref":"#/$defs/declaration"},
                "OFFBOARDING_AND_ACCESS_REVOCATION": {"$ref":"#/$defs/declaration"},
                "FAILURE_RECOVERY_AND_RECONCILIATION": {"$ref":"#/$defs/declaration"},
                "JIT_TRUSTED_LOGIN_AND_LINKING": {"$ref":"#/$defs/declaration"}
              }
            }
          }
        },
        {
          "properties": {
            "patternId": {"const":"SCIM_AND_JIT"},
            "declarations": {
              "type": "object",
              "additionalProperties": false,
              "maxProperties": 8,
              "properties": {
                "TENANT_AND_SUBJECT_CORRELATION": {"$ref":"#/$defs/declaration"},
                "ATTRIBUTE_OWNERSHIP_AND_MAPPING": {"$ref":"#/$defs/declaration"},
                "OFFBOARDING_AND_ACCESS_REVOCATION": {"$ref":"#/$defs/declaration"},
                "FAILURE_RECOVERY_AND_RECONCILIATION": {"$ref":"#/$defs/declaration"},
                "SCIM_CLIENT_SERVER_DIRECTION": {"$ref":"#/$defs/declaration"},
                "SCIM_USER_OPERATIONS": {"$ref":"#/$defs/declaration"},
                "JIT_TRUSTED_LOGIN_AND_LINKING": {"$ref":"#/$defs/declaration"},
                "SCIM_JIT_COLLISION_POLICY": {"$ref":"#/$defs/declaration"}
              }
            }
          }
        }
      ]
    }
  }
}
