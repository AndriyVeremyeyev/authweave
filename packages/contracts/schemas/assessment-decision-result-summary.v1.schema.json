{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://authweave.dev/contracts/assessment-decision-result-summary.v1.schema.json",
  "title": "Replay-verified owned decision advice summary v1",
  "description": "Core projects this bounded read-only summary only after whole historical replay, publication proof and owner audit verification. No new calculation, approval, source authentication or deployed configuration is asserted. It is not the full result receipt.",
  "type": "object", "additionalProperties": false,
  "required": ["scope", "workspaceId", "assessmentId", "item", "evaluatedAt", "profileSchemaVersion", "profileSha256", "policySha256", "weights", "status", "shortlist", "candidates", "verificationGapCount", "historicalReplayVerified", "externalSourceVerificationPerformed", "configurationVerified", "complianceVerified", "decisionApproved"],
  "properties": {
    "scope": { "const": "VERIFIED_ASSESSMENT_DECISION_SUMMARY" },
    "workspaceId": { "type": "string", "format": "uuid" }, "assessmentId": { "type": "string", "format": "uuid" },
    "item": { "$ref": "assessment-decision-result-page.v1.schema.json#/$defs/item" },
    "evaluatedAt": { "type": "string", "format": "date-time" },
    "profileSchemaVersion": { "type": "integer", "minimum": 1, "maximum": 6 },
    "profileSha256": { "type": "string", "pattern": "^[a-f0-9]{64}$" },
    "policySha256": { "type": "string", "pattern": "^[a-f0-9]{64}$" },
    "weights": { "$ref": "decision-result.v1.schema.json#/properties/weights" },
    "status": { "$ref": "assessment-decision-result.v1.schema.json#/$defs/decision/properties/status" },
    "shortlist": { "$ref": "decision-result.v1.schema.json#/$defs/ids" },
    "candidates": { "type": "array", "minItems": 1, "maxItems": 100, "items": { "$ref": "#/$defs/candidate" } },
    "verificationGapCount": { "const": 22 },
    "historicalReplayVerified": { "const": true },
    "externalSourceVerificationPerformed": { "const": false }, "configurationVerified": { "const": false },
    "complianceVerified": { "const": false }, "decisionApproved": { "const": false }
  },
  "$defs": {
    "candidate": { "type": "object", "additionalProperties": false,
      "required": ["optionId", "product", "plan", "region", "deployment", "hardVerdict", "score"],
      "properties": {
        "optionId": { "type": "string", "minLength": 1, "maxLength": 100 },
        "product": { "type": "string", "minLength": 1, "maxLength": 200 },
        "plan": { "type": "string", "minLength": 1, "maxLength": 200 }, "region": { "type": "string", "minLength": 1, "maxLength": 200 },
        "deployment": { "enum": ["MANAGED", "SELF_HOSTED"] }, "hardVerdict": { "enum": ["ELIGIBLE", "EXCLUDED", "UNRESOLVED"] },
        "score": { "anyOf": [{ "type": "null" }, { "type": "object", "additionalProperties": false,
          "required": ["lowerBound", "upperBound", "unknownWeight"], "properties": {
            "lowerBound": { "type": "integer", "minimum": 0, "maximum": 100 },
            "upperBound": { "type": "integer", "minimum": 0, "maximum": 100 },
            "unknownWeight": { "type": "integer", "minimum": 0, "maximum": 100 }
          }
        }] }
      }
    }
  }
}
